PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cryo_erp?replicaSet=rs0
JWT_SECRET=replace_with_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d
REQUIRE_REPLICA_SET=false
CORS_ORIGIN=*
ALLOW_DEMO_RESET=false
