{
  "name": "cryo-erp-backend",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node --loader tsx server.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 server/tests/erpLogic.test.ts server/tests/mongo-integration.test.ts server/tests/api-lifecycle.test.ts server/tests/security-auth.test.ts server/tests/sales-workflow.test.ts server/tests/supply-chain-workflow.test.ts server/tests/production-workflow.test.ts server/tests/production-form-refinement.test.ts server/tests/logistics-workflow.test.ts server/tests/shared-modules.test.ts server/tests/full-system-integration.test.ts server/tests/universal-rbac-approvals.test.ts server/tests/service-workflow.test.ts server/tests/rd-workflow.test.ts",
    "test:service": "tsx --test server/tests/service-workflow.test.ts",
    "test:rd": "tsx --test server/tests/rd-workflow.test.ts",
    "test:refinement": "tsx --test server/tests/production-form-refinement.test.ts",
    "test:approvals": "tsx --test server/tests/universal-rbac-approvals.test.ts",
    "test:full": "tsx --test server/tests/full-system-integration.test.ts",
    "test:shared": "tsx --test server/tests/shared-modules.test.ts",
    "test:logistics": "tsx --test server/tests/logistics-workflow.test.ts",
    "test:production": "tsx --test server/tests/production-workflow.test.ts",
    "test:supply-chain": "tsx --test server/tests/supply-chain-workflow.test.ts",
    "test:sales": "tsx --test server/tests/sales-workflow.test.ts",
    "test:security": "tsx --test server/tests/security-auth.test.ts",
    "test:integration": "tsx --test server/tests/api-lifecycle.test.ts server/tests/mongo-integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.14",
    "@types/pdfkit": "^0.17.5",
    "tsx": "^4.19.4",
    "typescript": "~5.8.2"
  }
}
