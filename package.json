{
  "name": "cryo-erp-root",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "lint:backend": "npm run lint --workspace backend",
    "test": "npm run test --workspace backend",
    "test:full": "npm run test:full --workspace backend",
    "test:shared": "npm run test:shared --workspace backend",
    "test:logistics": "npm run test:logistics --workspace backend",
    "test:production": "npm run test:production --workspace backend",
    "test:supply-chain": "npm run test:supply-chain --workspace backend",
    "test:sales": "npm run test:sales --workspace backend",
    "test:security": "npm run test:security --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "db:migrate": "tsx backend/server/migrations/migrateJsonToMongo.ts",
    "db:migrate:dry": "tsx backend/server/migrations/migrateJsonToMongo.ts --dry-run",
    "db:migrate:attachments": "tsx backend/server/migrations/migrateAttachments.ts",
    "db:migrate:attachments:dry": "tsx backend/server/migrations/migrateAttachments.ts --dry-run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/pdfkit": "^0.17.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.12.2",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
